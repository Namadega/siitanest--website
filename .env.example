# Copy this file to .env and fill in your own values before running in production.

PORT=3000

# Any long random string - used to sign login session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

NODE_ENV=production

# Set to 1 only if your site runs behind a reverse proxy (e.g. Nginx) that terminates HTTPS.
TRUST_PROXY=0

# Optional: only needed if you can't run "npm run setup" interactively
# (e.g. a hosting dashboard with no shell/console access). If no admin
# account exists yet, the app creates one automatically on startup using
# these two values. Password must be 8+ characters.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-this-password

# Optional: connect to MongoDB for permanent content storage. Needed on hosts
# with ephemeral/temporary disks (e.g. Render's free tier), where content
# saved to a local file would be lost on every restart. Leave unset to use
# simple local-file storage instead (fine for local development).
# Get a free connection string from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
# MONGODB_DB=siitanest
